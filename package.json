{
  "name": "rope-tangle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --disable-nested-config -c .oxlintrc.jsonc src tests e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "measure": "MEASURE=1 vitest run --silent=false tests/measure",
    "icons": "node scripts/make-icons.mjs",
    "bundled-boards": "node scripts/make-bundled-boards.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "~7.0.2003",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
